# GEMINI_API_KEY: Automatically injected at runtime by Google AI Studio.
# Used by the Vision Brain for attribute extraction and video match scoring.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The hosting URL (injected by AI Studio)
APP_URL="http://localhost:3000"

# OPENAI_API_KEY: Optional OpenAI key if OpenAI internet intelligence engine is configured
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# PORT
PORT=3000
