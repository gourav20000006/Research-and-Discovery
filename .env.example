# Port configuration (AI Studio uses 3000, standalone can use 3000 or 5000)
PORT=3000

# GEMINI_API_KEY: Primary multimodal model used for Vision Brain attribute extraction and video match scoring.
# Automatically injected in Google AI Studio, or paste your API key here.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional alternative vision provider.
OPENAI_API_KEY="sk-..."

# APP_URL: The hosting URL (injected by AI Studio)
APP_URL="http://localhost:3000"
